    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.4.11",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
